<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raw to GitHub Repo Converter</title>
<style>
    body {
        background: #0d1117;
        color: #c9d1d9;
        font-family: "Segoe UI", sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        gap: 10px;
    }
    h1 {
        color: #58a6ff;
        margin-bottom: 20px;
    }
    input {
        width: 80%;
        max-width: 600px;
        padding: 10px;
        border-radius: 8px;
        border: none;
        outline: none;
        background: #161b22;
        color: white;
    }
    button {
        background: #238636;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }
    button:hover {
        background: #2ea043;
    }
    .output {
        width: 80%;
        max-width: 600px;
        background: #161b22;
        padding: 10px;
        border-radius: 8px;
        word-wrap: break-word;
    }
</style>
</head>
<body>

<h1>Raw ➜ GitHub Repo Converter</h1>

<input type="text" id="rawInput" placeholder="Masukkan URL Raw GitHub...">
<div>
    <button onclick="convert()">Convert</button>
    <button onclick="copyResult()">Copy Result</button>
</div>

<div class="output" id="result">Hasil akan muncul di sini...</div>

<script>
function convert() {
    const rawUrl = document.getElementById("rawInput").value.trim();
    if (!rawUrl.startsWith("https://raw.githubusercontent.com/")) {
        document.getElementById("result").innerText = "URL tidak valid! Harus diawali dengan https://raw.githubusercontent.com/";
        return;
    }

    const repoUrl = rawUrl
        .replace("https://raw.githubusercontent.com/", "https://github.com/")
        .replace("/", "/blob/");

    document.getElementById("result").innerHTML = `<a href="${repoUrl}" target="_blank">${repoUrl}</a>`;
}

function copyResult() {
    const resultText = document.getElementById("result").innerText;
    navigator.clipboard.writeText(resultText).then(() => {
        alert("Berhasil disalin!");
    });
}
</script>

</body>
</html>
